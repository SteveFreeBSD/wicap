# WICAP Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control!

# =============================================================================
# Required Secrets (no defaults - MUST be set)
# =============================================================================
WICAP_SQL_PASSWORD=your_sql_password_here

# =============================================================================
# Optional Configuration (have sensible defaults)
# =============================================================================
# WICAP_SQL_HOST=192.168.4.25
# WICAP_SQL_DATABASE=SKYNET_CORE
# WICAP_SQL_USER=sa
# WICAP_SQL_DRIVER=ODBC Driver 18 for SQL Server

# Scout Configuration
# WICAP_INTERFACE=auto
# WICAP_INTERFACE_MAC=aa:bb:cc:dd:ee:ff
# WICAP_INTERFACE_REGEX=^wlan[0-9]+$
# WICAP_INTERFACE_EXCLUDE_REGEX=^wlan0$
# WICAP_ALLOW_MANAGEMENT_INTERFACE=false  # safety default: refuse default-route interface unless explicitly overridden
# WICAP_BT_ENABLED=false
# WICAP_BT_INTERFACE=auto
# WICAP_BT_INTERFACE_GLOB=/dev/serial/by-id/*nRF*
# WICAP_BT_SERIAL=5CE98EE77DD8C5C0
# WICAP_DWELL_THRESHOLD=1
# WICAP_DWELL_DURATION=30
# WICAP_CAPTURES_DIR=./captures
# WICAP_QUEUE_MAX_BYTES=52428800
# WICAP_QUEUE_MAX_FILES=5
# WICAP_QUEUE_BACKPRESSURE_MAX_BYTES=262144000
# WICAP_QUEUE_BACKPRESSURE_ACTION=drop_pulse
# WICAP_DEDUP_MAX_ENTRIES=10000

# Nexus Watcher
# WICAP_DWELL_BASELINE_ON_START=false

# UI Configuration
# WICAP_UI_DB_POOL_SIZE=5
# WICAP_CAPTURE_DIR=../captures  # UI capture folder (default: ../captures relative to wicap-ui)
# WICAP_REPLAY_LOG_DIR=/tmp      # Admin replay log directory
# WICAP_CONTROL_ACTIVE_POLICY_PROFILE=observe-v1
# WICAP_CONTROL_ACTIVE_POLICY_PROFILE_VERSION=1
# WICAP_CONTROL_ACTION_COOLDOWN_UNTIL=

# Intel worker / anomaly v2 / prediction artifacts
# WICAP_FEATURE_STREAM_ENABLED=true
# WICAP_BASELINE_STREAM_ENABLED=true
# WICAP_ANOMALY_STREAM_ENABLED=true
# WICAP_ANOMALY_SQL_PERSIST_ENABLED=false
# WICAP_INTEL_WORKER_INTERVAL_SECONDS=10
# WICAP_ANOMALY_EVENTS_PATH=./captures/wicap_anomaly_events.jsonl
# WICAP_ANOMALY_EVENTS_V2_PATH=./captures/wicap_anomaly_events_v2.jsonl
# WICAP_PREDICTION_EVENTS_PATH=./captures/wicap_predictions.jsonl
# WICAP_PREDICTION_HORIZONS_SEC=300,1800

# OTLP local observability defaults
# WICAP_OTLP_PROFILE=self_hosted
# WICAP_OTLP_HTTP_ENDPOINT=http://localhost:4318/v1/logs
